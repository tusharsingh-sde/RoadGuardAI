
# RoadGuard AI - Backend Environment Config
#
#   cp .env.example .env


# ---------------- SUPABASE (PDF report storage) ----------------

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET=pothole-reports

# ---------------- EMAIL (Report ko admin ko bhejne ke liye) ----------------

SENDER_EMAIL=your-app-email@gmail.com
# Gmail "App Password" — not a normal gmail password
# how to create: Google Account -> Security -> 2-Step Verification -> App Passwords
SENDER_APP_PASSWORD=your-16-char-app-password
# email of the person who will recieve the mail (admin/owner)
ADMIN_EMAIL=admin@example.com


SMTP_HOST=smtp.gmail.com
SMTP_PORT=587


# ---------------- SERVER / RUNTIME ----------------
# Default 1 
WEB_CONCURRENCY=1


# ---------------- SECURITY & VALIDATION ----------------
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# for Production -> true rakho; for local testing without frontend token -> false
REQUIRE_AUTH=true

# only the email with this domain can register
ALLOWED_EMAIL_DOMAIN=miet.ac.in

# USB/webcam index (e.g. 0) for local machine par == true ; for cloud VM == false
ALLOW_LOCAL_CAM=false

# Local Wi-Fi IP cameras (192.168.x.x / 10.x.x.x) for local dev -> true ; for cloud VM -> false
ALLOW_PRIVATE_CAM_IPS=false

# Max video upload size in MB
MAX_UPLOAD_MB=200


# ---------------- INFERENCE ----------------
# How many YOLO inferences can run simultaneously on a CPU (2 is safe on a small VM)
MAX_CONCURRENT_INFERENCE=2


# ---------------- REPORTS & CLEANUP ----------------
# SMTP connection timeout in seconds 
SMTP_TIMEOUT_SECONDS=20

# Generated PDFs, status files, and stray captures deletion time (hours)
REPORT_TTL_HOURS=24

# Report generation background worker pool size
REPORT_WORKERS=2
