# ============================================================
# RoadGuard AI - Backend Environment Config
# ============================================================
# Ye file copy karke ".env" bana lo (same folder me) aur apni
# actual values daal do. ".env" ko kabhi bhi git me commit mat
# karna — .gitignore me already add hai.
#
#   cp .env.example .env
# ============================================================

# ---------------- SUPABASE (PDF report storage) ----------------
# Supabase project ke "Project Settings > API" me milega
SUPABASE_URL=https://your-project-ref.supabase.co
# service_role key use karo (Storage upload ke liye chahiye hoti hai)
SUPABASE_KEY=your-supabase-service-role-key
# Storage bucket ka naam (Supabase dashboard me pehle se bana lena, "Public" bucket)
SUPABASE_BUCKET=pothole-reports

# ---------------- EMAIL (Report ko admin ko bhejne ke liye) ----------------
# Jis email se report bhejni hai (Gmail recommended)
SENDER_EMAIL=your-app-email@gmail.com
# Gmail "App Password" — normal Gmail password NAHI chalega.
# Kaise banaye: Google Account -> Security -> 2-Step Verification -> App Passwords
SENDER_APP_PASSWORD=your-16-char-app-password
# Jis email par report/PDF receive karni hai (admin/owner)
ADMIN_EMAIL=admin@example.com

# SMTP settings (Gmail ke liye defaults already sahi hain, change mat karo
# jab tak koi dusra provider (Outlook/Zoho etc.) use na kar rahe ho)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587


# ---------------- SERVER / RUNTIME ----------------
# Default 1 rakho taaki har worker alag PyTorch/YOLO load karke RAM OOM na kare
WEB_CONCURRENCY=1


# ---------------- SECURITY & VALIDATION ----------------
# Comma-separated frontend origins (wildcard "*" mat rakho credentials ke saath)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production mein true rakho; local testing bina frontend token ke karni ho toh false
REQUIRE_AUTH=true

# Backend-level domain check (blank chhodoge toh koi bhi authenticated Supabase user allow hoga)
ALLOWED_EMAIL_DOMAIN=miet.ac.in

# USB/webcam index (e.g. 0) sirf local machine par true rakho, cloud VM par false
ALLOW_LOCAL_CAM=false

# Local Wi-Fi IP cameras (192.168.x.x / 10.x.x.x) sirf local dev par true rakho, cloud VM par false
ALLOW_PRIVATE_CAM_IPS=false

# Max video upload size in MB
MAX_UPLOAD_MB=200


# ---------------- INFERENCE ----------------
# Ek saath kitni YOLO inferences CPU par run hongi (small VM par 2 safe hai)
MAX_CONCURRENT_INFERENCE=2
